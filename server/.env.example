DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datakitchen
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
# STORAGE_PROVIDER=azure
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=imports
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
AUTH_MODE=development
# DEV_AUTH_TOKEN — required when AUTH_MODE=development.
# Internal testing only. Will be replaced by real token acquisition.
DEV_AUTH_TOKEN=dk-dev-internal-2026
# --- Cloud (Microsoft Entra ID) ---
# Set AUTH_MODE=entra in the cloud. DEV_AUTH_TOKEN must NOT be set alongside it —
# config.ts fails fast if it is. Both values below are non-secret identifiers.
# AUTH_MODE=entra
# ENTRA_TENANT_ID=<mirchi-labs-tenant-id>
# ENTRA_API_CLIENT_ID=<data-kitchen-api-dev-client-id>
#
# Generic OIDC mode (not used by the current deployment)
# AUTH_MODE=production
# AUTH_ISSUER=
# AUTH_AUDIENCE=
# AUTH_JWKS_URI=
MAX_UPLOAD_SIZE_MB=50
MAX_IMPORT_ROWS=10000
ALLOWED_ORIGINS=http://localhost:5173
# Seed script safeguard — required to run prisma/seed.ts
# ALLOW_DEV_SEED=true
# Cloud bootstrap safeguard — required to run prisma/bootstrap-cloud.ts
# ALLOW_CLOUD_BOOTSTRAP=true
# PRIMARY_USER_OID=<entra-object-id>
# PRIMARY_USER_EMAIL=<upn>
# PRIMARY_USER_NAME=<display name>
