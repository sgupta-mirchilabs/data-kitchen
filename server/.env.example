DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datakitchen
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
# STORAGE_PROVIDER=azure
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=imports
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
AUTH_MODE=development
# DEV_AUTH_TOKEN — required when AUTH_MODE=development.
# Internal testing only. Will be replaced by real token acquisition.
DEV_AUTH_TOKEN=dk-dev-internal-2026
# AUTH_MODE=production
# AUTH_ISSUER=
# AUTH_AUDIENCE=
# AUTH_JWKS_URI=
MAX_UPLOAD_SIZE_MB=50
MAX_IMPORT_ROWS=10000
ALLOWED_ORIGINS=http://localhost:5173
# Seed script safeguard — required to run prisma/seed.ts
# ALLOW_DEV_SEED=true
